{
  "expo": {
    "name": "MyProxy",
    "slug": "myproxy-xray",
    "version": "0.0.10",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "myproxy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "one.leaper.myproxy.xray"
    },
    "android": {
      "package": "one.leaper.myproxy.xray",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220"
      }
    },
    "plugins": [
      "expo-file-system",
      ["expo-camera", { "cameraPermission": "允许 MyProxy 使用相机扫描节点二维码" }],
      "expo-document-picker"
    ],
    "extra": {
      "channel": "xray"
    }
  }
}
